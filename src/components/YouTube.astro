---
// A lightweight YouTube embed: shows the thumbnail and only loads YouTube's
// player when clicked, so pages with several videos stay fast.
interface Props {
  id: string;
  title: string;
  list?: string;
}

const { id, title, list } = Astro.props;
const params = new URLSearchParams({ autoplay: '1', rel: '0' });
if (list) params.set('list', list);
const embed = `https://www.youtube-nocookie.com/embed/${id}?${params}`;
const watch = `https://www.youtube.com/watch?v=${id}${list ? `&list=${list}` : ''}`;
---

<figure class="video">
  <div class="frame">
    <button class="yt-play" type="button" data-embed={embed} data-title={title} aria-label={`Play video: ${title}`}>
      <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" width="480" height="360" />
      <span class="icon" aria-hidden="true">
        <svg viewBox="0 0 68 48" width="56" height="40"><path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.3.3 34 .3 34 .3s-21.3 0-26.6 1.4a8.5 8.5 0 0 0-6 6C0 13 0 24 0 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6C12.7 47.7 34 47.7 34 47.7s21.3 0 26.6-1.4a8.5 8.5 0 0 0 6-6C68 35 68 24 68 24s0-11-1.5-16.3Z" fill="#000" fill-opacity=".72"></path><path d="M27 34V14l18 10-18 10Z" fill="#fff"></path></svg>
      </span>
    </button>
  </div>
  <figcaption><a href={watch}>{title}</a></figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLButtonElement>('.yt-play').forEach((button) => {
    button.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.src = button.dataset.embed!;
        iframe.title = button.dataset.title!;
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        button.replaceWith(iframe);
        iframe.focus();
      },
      { once: true },
    );
  });
</script>

<style>
  .video {
    margin: 0;
  }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: #000;
  }
  .frame :global(iframe),
  .yt-play {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .yt-play {
    padding: 0;
    background: none;
    cursor: pointer;
  }
  .yt-play img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.2s;
  }
  .yt-play:hover img {
    opacity: 0.88;
  }
  .icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .yt-play:hover .icon path:first-child,
  .yt-play:focus-visible .icon path:first-child {
    fill: #f00;
    fill-opacity: 1;
  }
  figcaption {
    margin-top: 0.55rem;
    font-family: var(--sans);
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.35;
  }
  figcaption a {
    color: var(--text);
    text-decoration: none;
  }
  figcaption a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
