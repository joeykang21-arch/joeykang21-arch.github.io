---
// Renders one photo from src/assets/photos/<id>.jpg with the alt text,
// caption and credit from src/data/photos.yaml.
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  /** Crop to this width/height ratio at build time, e.g. 4 / 5 for the home page tiles. */
  crop?: number;
}

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });

const { id, sizes = '(min-width: 760px) 30rem, 100vw', loading = 'lazy', class: className, crop } = Astro.props;
const image = images[`../assets/photos/${id}.jpg`]?.default;
const entry = await getEntry('photos', id);
if (!image) throw new Error(`Photo "${id}": no file at src/assets/photos/${id}.jpg`);
if (!entry) throw new Error(`Photo "${id}": no entry in src/data/photos.yaml`);
const { alt, caption, credit } = entry.data;

// Cropping here (not with CSS object-fit) keeps each generated size sharp:
// the browser downloads exactly the pixels it shows.
const cropWidth = crop ? Math.round(Math.min(image.width, image.height * crop)) : undefined;
const widths = [400, 700, 1000, 1400].filter((w) => !cropWidth || w < cropWidth);
if (cropWidth) widths.push(cropWidth);
const cropSize = crop && cropWidth ? { width: cropWidth, height: Math.round(cropWidth / crop), fit: 'cover' as const } : {};
---

<figure class:list={['photo', className]}>
  <Image
    src={image}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={loading}
    quality={70}
    {...cropSize}
  />
  {
    (caption || credit) && (
      <figcaption>
        {caption}
        {caption && credit && ' · '}
        {credit && <span class="credit">Photo: {credit}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .photo {
    margin: 0;
  }
  img {
    width: 100%;
    border-radius: var(--radius);
    background: var(--surface);
  }
  figcaption {
    margin-top: 0.5rem;
    font-family: var(--sans);
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--muted);
  }
  .credit {
    font-style: italic;
  }
</style>
