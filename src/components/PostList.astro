---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../site';

interface Props {
  posts: CollectionEntry<'writing'>[];
}

const { posts } = Astro.props;
---

<ul class="posts">
  {
    posts.map((post) => (
      <li>
        <time class="meta" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <div>
          <a class="title" href={`/writing/${post.id}/`}>
            {post.data.title}
          </a>
          <p>{post.data.description}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    gap: 0.2rem 1.5rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--rule);
  }
  li:first-child {
    padding-top: 0;
  }
  @media (min-width: 640px) {
    li {
      grid-template-columns: 9.5rem 1fr;
      align-items: baseline;
    }
  }
  .title {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
    text-decoration: none;
  }
  .title:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  p {
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.95em;
  }
</style>
